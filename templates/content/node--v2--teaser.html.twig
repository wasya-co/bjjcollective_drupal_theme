
{%
  set classes = [
    'Teaser',

    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}
{{ attach_library('ish_drupal_theme/node') }}

<article{{ attributes.addClass(classes) }}>

  <div class='d-flex'>
    <div class='mr-2' style="" >
      {{ content.field_vote_up_down }}
    </div>
    <div class='d-flex lvl-1 '>

      <div class="d-flex mt-2 mr-2 align-items-start " >
        {% if content.field_image_thumb_url %}
          <a href="{{ url }}" >
            <img class='image-thumb' src="{{- content.field_image_thumb_url|escape|striptags|replace({"\n": "", "\r": "", "\t": ""}) -}}" alt='' />
          </a>
        {% endif %}
        {% if content.field_image_thumb %}
          {{ content.field_image_thumb }}
        {% endif %}
        <img class='thumb' src="https://img.youtube.com/vi/{{- content.field_youtube_id |escape|striptags|replace({"\n": "", "\r": "", "\t": ""})|replace({" ":""}) -}}/0.jpg" alt='' />

      </div>
      <div class=''>
        {{ title_prefix }}
        {% if label and not page %}
          <h2{{ title_attributes }}>
            <a href="{{ url }}" rel="bookmark">{{ label }}</a>
          </h2>
        {% endif %}
        {{ title_suffix }}

        {# {% if display_submitted %}
          <footer class="node__meta">
            {{ author_picture }}
            <div{{ author_attributes.addClass('node__submitted') }}>
              {% trans %}Submitted by {{ author_name }} on {{ date }}{% endtrans %}
              {{ metadata }}
            </div>
          </footer>
        {% endif %} #}

        <div{{ content_attributes.addClass('node__content') }}>
          {{ content | without('field_youtube_id') | without('field_vote_up_down') | without('field_image_thumb') | without('field_image_thumb_url') }}
        </div>

      </div>
    </div>
  </div>



  <div class="clearfix"></div>

</article>

